{
  "name": "varzia-prime-resurgence-planner",
  "private": true,
  "type": "module",
  "scripts": {
    "build:locales": "node scripts/build-locales.mjs",
    "check:locales": "node scripts/build-locales.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/check-syntax.mjs && npm test && git diff --check",
    "prime-resurgence:sync": "node scripts/prime-resurgence-sync.mjs",
    "prime-resurgence:dry-run": "node scripts/prime-resurgence-sync.mjs --dry-run",
    "prime-resurgence:prepare-release": "node scripts/prime-resurgence-prepare-release.mjs",
    "sandbox:run": "node tools/sandbox/run.mjs",
    "sandbox:agent": "node tools/sandbox/run.mjs --executor codex"
  }
}
